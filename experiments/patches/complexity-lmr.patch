diff --git a/src/faye.h b/src/faye.h
new file mode 100644
index 0000000..b21f000
--- /dev/null
+++ b/src/faye.h
@@ -0,0 +1,26 @@
+/*
+  FayE Brain experimental search controls.
+
+  This header deliberately contains only tiny inline scalar controls so an
+  experimental feature can be tuned through UCI without adding a runtime
+  dependency or changing Stockfish defaults.
+*/
+
+#ifndef FAYE_H_INCLUDED
+#define FAYE_H_INCLUDED
+
+namespace Stockfish::FayE {
+
+// Positive values make high-complexity quiet moves receive *less* LMR.
+// Negative values make them receive more LMR. Zero disables the experiment.
+inline int ComplexityLMRWeight = 0;
+
+// The material/NNUE disagreement value above which the LMR adjustment starts.
+inline int ComplexityThreshold = 384;
+
+// Maximum absolute LMR adjustment in Stockfish's internal 1/1024-ply units.
+inline int ComplexityLMRCap = 1024;
+
+}  // namespace Stockfish::FayE
+
+#endif  // #ifndef FAYE_H_INCLUDED
